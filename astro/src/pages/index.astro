---
import SiteLayout from "../layouts/SiteLayout.astro";
import Prompt from "../components/Prompt.astro";
import PostList from "../components/PostList.astro";
---

<SiteLayout>
  <section class="home-intro" aria-labelledby="intro-title">
    <Prompt command="whoami" />
    <h1 id="intro-title">Hey, I'm John<span class="accent">.</span><span class="cursor" aria-hidden="true">_</span></h1>
    <p class="intro-role">Site Reliability Engineer <span class="muted">@</span> <a href="https://www.udemy.com/">Udemy <span aria-hidden="true">↗</span></a></p>
    <div class="hero-actions">
      <a class="button button-primary" href="/about/">About me <span aria-hidden="true">→</span></a>
      <a class="button button-resume" href="/files/jpena_cv.pdf">View resume <span aria-hidden="true">↗</span></a>
    </div>
    <div class="social-links">
      <a href="https://github.com/jpenagg/">GitHub ↗</a>
      <a href="https://linkedin.com/in/jpenagg/">LinkedIn ↗</a>
      <a href="https://twitter.com/jpena23">Twitter ↗</a>
      <a href="mailto:jsp3na@gmail.com">Email ↗</a>
    </div>
  </section>

  <section class="home-writing" aria-labelledby="writing-title">
    <div class="section-heading"><h2 id="writing-title">Recent posts</h2><a class="text-link" href="/posts/">All posts <span aria-hidden="true">→</span></a></div>
    <PostList compact limit={3} />
  </section>
</SiteLayout>

<style>
  .home-intro { padding-block: 48px 64px; }
  .home-intro :global(.command-label) { margin-bottom: 16px; }
  .home-intro h1 { margin-bottom: 20px; }
  .intro-role { margin-bottom: 24px; }
  .intro-role a { color: var(--accent); text-decoration-color: var(--border); white-space: nowrap; }
  .intro-role a:hover { text-decoration-color: var(--accent); }
  .hero-actions .button { min-height: 48px; padding: 14px 20px; font-size: 13px; }
  .home-intro .hero-actions .button-resume { background: #101412; color: #e7ece7; }
  .home-writing { border-top: 1px solid var(--border); padding-top: 28px; }
  .home-writing .section-heading { align-items: baseline; margin-bottom: 12px; }
  .home-writing h2 { font-size: 18px; }

  @media (max-width: 540px) {
    .home-intro { padding-block: 32px 48px; }
  }
</style>
