---
import SiteLayout from "../../layouts/SiteLayout.astro";
import Prompt from "../../components/Prompt.astro";
import PostList from "../../components/PostList.astro";
---

<SiteLayout title="Posts" description="Notes on site reliability, infrastructure, and practical engineering by John Peña.">
  <div class="content-page">
    <header class="page-header"><Prompt command="ls ./posts" /><h1>Field <span class="accent">notes.</span></h1><p class="page-lede">Reliability, infrastructure, and lessons learned along the way.</p></header>
    <div class="file-list-header"><span>./posts/</span><span>sorted: newest first</span></div>
    <PostList />
    <p class="end-of-list"><span class="accent" aria-hidden="true">✓</span> You've reached the end. More to come.</p>
  </div>
</SiteLayout>
