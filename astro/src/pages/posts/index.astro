---
import SiteLayout from "../../layouts/SiteLayout.astro";
import Prompt from "../../components/Prompt.astro";
import PostList from "../../components/PostList.astro";
---

<SiteLayout title="Posts" description="Notes on site reliability, infrastructure, and practical engineering by John Peña.">
  <div class="content-page">
    <header class="page-header"><Prompt command="ls ./posts" /><h1>Posts<span class="accent">.</span></h1></header>
    <div class="file-list-header"><span>./posts/</span><span>sorted: newest first</span></div>
    <PostList />
  </div>
</SiteLayout>
