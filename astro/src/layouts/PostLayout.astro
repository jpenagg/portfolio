---
import SiteLayout from "./SiteLayout.astro";
import Prompt from "../components/Prompt.astro";
const { title, description, date, category } = Astro.props.frontmatter;
const filename = Astro.url.pathname.split("/").filter(Boolean).pop();
---

<SiteLayout title={title} description={description}>
  <article class="content-page post">
    <a class="back-link" href="/posts/">← Back to posts</a>
    <header class="page-header post-header">
      <Prompt command={`cat ${filename}.md`} />
      <h1>{title}</h1>
      <div class="post-row-meta"><span>{category}</span><span aria-hidden="true">/</span><time datetime={date}>{new Date(`${date}T00:00:00Z`).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" })}</time></div>
    </header>
    <div class="post-body prose"><slot /></div>
    <div class="post-end"><span class="code-comment"># thanks for reading</span><a class="text-link" href="/posts/">More notes ←</a></div>
  </article>
</SiteLayout>
