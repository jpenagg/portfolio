---
interface Props {
  compact?: boolean;
  limit?: number;
}

const { compact = false, limit } = Astro.props;
const posts = (await Astro.glob("../pages/posts/*.md")).sort(
  (a, b) => Date.parse(b.frontmatter.date) - Date.parse(a.frontmatter.date)
).slice(0, limit);
---
<ul class:list={["post-list", { "post-list-compact": compact }]}>
  {posts.map((post, index) => (
    <li>
      <a class="post-row" href={post.url}>
        {!compact && <span class="post-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>}
        <div class="post-row-content">
          <div class="post-row-meta">{!compact && <><span>{post.frontmatter.category}</span><span aria-hidden="true">/</span></>}<time datetime={post.frontmatter.date}>{new Date(`${post.frontmatter.date}T00:00:00Z`).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" })}</time></div>
          <h3>{post.frontmatter.title}</h3>
          {!compact && <p>{post.frontmatter.description}</p>}
        </div>
        <span class="post-arrow" aria-hidden="true">↗</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .post-list-compact li:last-child { border-bottom: 0; }
  .post-list-compact .post-row { padding: 20px 0; }
  .post-list-compact h3 { margin: 6px 0 0; line-height: 1.6; }
  .post-list-compact .post-row-meta { font-size: 11px; }
  .post-list-compact .post-arrow { font-size: 16px; }
</style>
